@page
@model Matvi.Front.UI.Pages.Security.LoginModel
@{
    Layout = null;
}
<html lang="es-mx" data-bs-theme="light" data-menu-color="brand" data-topbar-color="light">
<head>
    <meta charset="utf-8" />
    <title>Log In | Matvi - Materiales Villanueva</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="Digintel Solutions" name="author" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="~/assets/images/favicon.ico">

    <!-- Web App Manifest -->
    <link rel="manifest" href="~/manifest.json" />

    <link href="/assets/css/style.css" rel="stylesheet" />
    <link href="/assets/css/icons.min.css" rel="stylesheet" />
    <link href="/css/site.css" rel="stylesheet" />
</head>

<body class="d-flex justify-content-center align-items-center min-vh-100 p-5">

    <div class="container">

        <div class="row justify-content-center">
            <div class="col-xl-4 col-md-5">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-9">
                                <div class="text-start auth-logo">
                                    <a href="#" class="logo-dark">
                                        <span><img src="~/assets/images/logo-dark.png" alt="" height="22"></span>
                                    </a>

                                    <a href="#" class="logo-light">
                                        <span><img src="~/assets/images/logo-light.png" alt="" height="22"></span>
                                    </a>
                                </div>
                            </div>
                            <div class="col-3">
                                <ul class="p-0 m-0 text-end">
                                    <li class="nav-link" id="theme-mode" style="cursor: pointer">
                                        <i href="#" class="bx bx-moon font-size-24"></i>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <h4 class="card-title mb-3">Iniciar sesion</h4>
                        <form method="post" asp-page-handler="Login">

                            <div class="form-group mb-3">
                                <input class="form-control" asp-for="UsuarioFld" placeholder="Ingresa tu usuario">
                                <span asp-validation-for="UsuarioFld"></span>
                            </div>

                            <div class="form-group mb-3">
                                <input class="form-control" asp-for="ContraseniaFld" placeholder="Ingresa tu contraseña">
                                <span asp-validation-for="ContraseniaFld"></span>
                            </div>

                            <div class="form-group mb-3">
                                <div class="">
                                    <input class="form-check-input" asp-for="Recordarme" type="checkbox" id="checkbox-signin" checked>
                                    <label class="form-check-label ms-2" asp-for="Recordarme"></label>
                                </div>
                            </div>

                            <div class="form-group mb-0 text-center">
                                <button class="btn mv-btn-enf5 w-100" type="submit"> Ingresar </button>
                            </div>

                            <div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>

                        </form>
                    </div> <!-- end card-body -->
                </div>
                <!-- end card -->
            </div> <!-- end col -->
        </div>
        <!-- end row -->
    </div>

    <!-- App js -->
    <script src="~/assets/js/vendor.min.js"></script>
    <script src="~/assets/libs/jquery-knob/jquery.knob.min.js"></script>
    <script src="~/assets/js/app.js"></script>
    <script src="~/assets/js/config.js"></script>

</body>
</html>
