@page
@model Matvi.Front.UI.Pages.Security.ChangePasswordModel
@{
    Layout = null;
}
<html lang="es-mx" data-bs-theme="light" data-menu-color="brand" data-topbar-color="light">

<head>
    <meta charset="utf-8" />
    <title>Log In | Matvi - Materiales Villanueva</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="Digintel Solutions" name="author" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="~/assets/images/favicon.ico">

    <!-- App css -->
    <link href="~/assets/css/style.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />

    <!-- Libs -->
    <link href="~/lib/jquery-confirm/jquery-confirm.min.css" rel="stylesheet" />

    <!-- Matvi CSS -->
    <link href="~/css/site.css" rel="stylesheet" />

    <style>

        .password-wrapper {
            position: relative;
            display: inline-block;
            width: 100%;
        }

        .password-field {
            /* padding-right: 30px; /* espacio para el ojito */ */
        }

        .toggle-visibility {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            font-size: 18px;
        }


    </style>

</head>
<body class="d-flex justify-content-center align-items-center min-vh-100 p-5">

    <div class="container">

        <div class="row justify-content-center">
            <div class="col-xl-4 col-md-5">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-9">
                                <div class="text-start auth-logo">
                                    <a href="#" class="logo-dark">
                                        <span><img src="~/assets/images/logo-dark.png" alt="" height="22"></span>
                                    </a>

                                    <a href="#" class="logo-light">
                                        <span><img src="~/assets/images/logo-light.png" alt="" height="22"></span>
                                    </a>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <ul class="p-0 m-0 text-end">
                                    <li class="nav-link" id="theme-mode" style="cursor: pointer">
                                        <i href="#" class="bx bx-moon font-size-24"></i>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <h4 class="card-title mb-3">Cambiar contraseña</h4>
                        <form id="frmChangePassword"
                              class="needs-validation"
                              method="post" 
                              asp-page-handler="ChangePassword"
                              data-ajax="true"
                              data-ajax-success="Success_ChangePassword">

                            <input asp-for="Usuario.SafeId" type="hidden" />

                            <div class="form-group mb-3">
                                <label asp-for="UsuarioFld" class="form-label"></label>
                                <output class="form-control mv-output-control">
                                    @Model.UsuarioFld
                                </output>
                            </div>
                            <div class="form-group mb-3">
                                <div class="password-wrapper">
                                    <input asp-for="Usuario.ContraseniaFld" class="form-control password-field NotUpper" placeholder="Ingresa la nueva contraseña">
                                    <span class="toggle-visibility bx bx-show" onclick="togglePassword('Usuario_ContraseniaFld')"></span>
                                </div>
                                <span asp-validation-for="Usuario.ContraseniaFld"></span>
                            </div>
                            <div class="form-group mb-3">
                                <div class="password-wrapper">
                                    <input asp-for="Usuario.ConfirmarContraseniaFld" class="form-control password-field NotUpper" placeholder="Confirma la nueva contraseña">
                                    <span class="toggle-visibility bx bx-show" onclick="togglePassword('Usuario_ConfirmarContraseniaFld')"></span>
                                </div>
                                <span asp-validation-for="Usuario.ConfirmarContraseniaFld"></span>
                            </div>
                            <div class="form-group mb-0 text-center">
                                <button class="btn w-100 mv-btn-primary" type="button">
                                    Cambiar contraseña
                                </button>
                            </div>
                        </form>
                    </div> <!-- end card-body -->
                </div>
                <!-- end card -->
            </div> <!-- end col -->
        </div>
        <!-- end row -->
    </div>

    <!-- App js -->
    <script src="~/assets/js/vendor.min.js"></script>
    <script src="~/assets/libs/jquery-knob/jquery.knob.min.js"></script>
    <script src="~/assets/js/app.js"></script>
    <script src="~/assets/js/config.js"></script>

    <!-- Libs -->
    <script src="~/lib/jquery-confirm/jquery-confirm.min.js"></script>
    <script src="~/lib/jquery.blockui/jquery.blockui.min.js"></script>
    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.min.js"></script>

    <!-- Matvi JS -->
    <script src="~/js/site.js"></script>
    
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>

        $("#frmChangePassword .mv-btn-primary").on("click", function () {
            if ($("#frmChangePassword").valid()) {
                Matvi.confirm('@Html.Raw("Cambiar contraseña")', "¿Confirma guardar la nueva contraseña del usuario?", function (resp) {
                    if (resp == true) {
                        $("#frmChangePassword").submit();
                    }
                });
            }
        });

        function Success_ChangePassword(response) {
            Matvi.alert(response.messageType, "Cambiar contraseña", response.message, function () {
                if(response.data == true) {
                    location.href = "Login";
                }
            });
        }
        
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            input.type = input.type === "password" ? "text" : "password";
        }
    </script>
</body>
</html>
