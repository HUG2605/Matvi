@page
@using Matvi.Front.UI.Security.Permission
@using Matvi.Front.UI.Security.Services
@inject IUsuarioActualService UsuarioActualService
@model Matvi.Front.UI.Areas.Ventas.Pages.Pedido.IndexModel
@{
    ViewData["Title"] = "Pedidos";
    ViewData["Modulo"] = "Ventas";
    ViewData["RequiereSucursal"] = true;
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var verSensibles = UsuarioActualService.PuedeVerSensibles(Funcion.Ventas_Pedidos);
}

@await Html.PartialAsync("_DataTablesStylesPartial")

<div id="contenedorBotonNuevo" style="display:none;">
    @if (UsuarioActualService.TienePermiso(Funcion.Ventas_Pedidos, Accion.Crear))
    {
        <a id="btnNuevo" class="btn mv-btn-primary me-2 mb-1"
           asp-page="/Pedido/Create"
           data-ajax="true"
           data-ajax-update="#ContainerModal"
           data-ajax-method="GET"
           data-ajax-mode="replace"
           title="Crear" aria-label="Crear">
            <i class="mdi mdi-plus-circle-outline"></i> Nuevo
        </a>
    }
</div>

<table id="pedido-datatable"
       class="table table-sm table-hover activate-select dt-responsive nowrap w-100"
       data-ver-sensibles="@verSensibles.ToString().ToLower()">
    <thead>
        <tr>
            <th>Folio</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Teléfono</th>
            <th>Canal de captura</th>
            <th>Estatus</th>
            <th class="text-center">Entrega a domicilio</th>
            @if (verSensibles)
            {
                <th class="text-end">Total</th>
            }
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<div id="ContainerModal"></div>

@section Scripts {
    @await Html.PartialAsync("_DataTablesScriptsPartial")
    <script src="~/js/modules/Ventas/Pedido/Index.js" asp-append-version="true"></script>
}