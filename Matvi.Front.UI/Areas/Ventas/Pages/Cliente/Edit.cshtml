@page
@model Matvi.Front.UI.Areas.Ventas.Pages.Cliente.EditModel
@{
    Layout = null;
    var title = "Datos del cliente";
    var idModal = "mdlEditCliente";
    var idForm = "frmEditCliente";
}
<link href="~/css/matvi.stepper.css" rel="stylesheet" />
<form id="@idForm"
      class="needs-validation"
      method="post"
      asp-page-handler="Edit"
      data-ajax="true"
      data-ajax-success="Success_Edit">

    <input asp-for="Cliente.SafeId" type="hidden" />

    <div class="modal fade show" id="@idModal" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="true" tabindex="-1" aria-labelledby="staticBackdropLabel">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h4 class="modal-title">@title</h4>
                    <button type="button" class="btn-close btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col text-start">
                            <h5 class="mv-text-enf3">
                                <i class="mdi mdi-plus-circle-outline me-2"></i>Editar
                            </h5>
                        </div>
                        <div class="col text-end">
                            <label class="form-label text-danger">&#9679; Valores requeridos</label>
                        </div>
                    </div>
                    <div class="mv-steps-vertical">
                        <div class="mv-step-vertical active">



                            <div class="mv-step-vertical-icon">1</div>
                            <div class="mv-step-vertical-content">
                                <div class="mv-step-vertical-title">
                                    Generales
                                </div>
                                <div id="collapseGenerales" class="mv-step-vertical-body collapse show">
                                    <div class="row g-3">

                                        <div class="col-md-12">
                                            <label asp-for="Cliente.NombreFld" class="form-label mv-form-label-required"></label>
                                            <input asp-for="Cliente.NombreFld" class="form-control" />
                                            <span asp-validation-for="Cliente.NombreFld"></span>
                                        </div>
                                        <div class="col-md-12">
                                            <label asp-for="Cliente.DireccionFld" class="form-label mv-form-label-required"></label>
                                            <div class="input-group">
                                                <span class="input-group-text p-0 ps-2 pe-2">
                                                    <i class="mdi mdi-map-marker"></i>
                                                </span>
                                                <textarea asp-for="Cliente.DireccionFld" class="form-control" rows="2"></textarea>
                                            </div>
                                            <span asp-validation-for="Cliente.DireccionFld"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="Cliente.TelefonoFld" class="form-label mv-form-label-required"></label>
                                            <div class="input-group">
                                                <span class="input-group-text p-0 ps-2 pe-2">
                                                    <i class="mdi mdi-phone"></i>
                                                </span>
                                                <input asp-for="Cliente.TelefonoFld" class="form-control" />
                                            </div>
                                            <span asp-validation-for="Cliente.TelefonoFld"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="Cliente.AliasFld" class="form-label"></label>
                                            <input asp-for="Cliente.AliasFld" class="form-control" />
                                            <span asp-validation-for="Cliente.AliasFld"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="Cliente.LimiteCreditoSemanalFld" class="form-label"></label>
                                            <div class="input-group">
                                                <span class="input-group-text p-0 ps-2 pe-2"><i class="mdi mdi-currency-usd"></i></span>
                                                <input asp-for="Cliente.LimiteCreditoSemanalFld" class="form-control" type="number" step="0.01" min="0" />
                                            </div>
                                            <span asp-validation-for="Cliente.LimiteCreditoSemanalFld"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mv-step-vertical">
                            <div class="mv-step-vertical-icon">2</div>
                            <div class="mv-step-vertical-content">
                                <div class="mv-step-vertical-title">
                                    Fiscales
                                </div>
                                <div id="collapseFiscales" class="mv-step-vertical-body collapse">
                                    <div class="row g-3">
                                    
                                    <div class="col-md-12">
                                        <label asp-for="Cliente.IdCatRegimenFiscalFld" class="form-label"></label>
                                        <select asp-for="Cliente.IdCatRegimenFiscalFld" class="form-select" asp-items="Model.RegimenFiscalSelectList">
                                            <option value="">SELECCIONAR</option>
                                        </select>
                                        <span asp-validation-for="Cliente.IdCatRegimenFiscalFld"></span>
                                    </div>
                                        <div class="col-md-12">
                                            <label asp-for="Cliente.RFCFld" class="form-label"></label>
                                            <input asp-for="Cliente.RFCFld" class="form-control" />
                                            <span asp-validation-for="Cliente.RFCFld"></span>
                                        </div>
                                        <div class="col-md-12">
                                            <label asp-for="Cliente.CalleFiscalFld" class="form-label"></label>
                                            <input asp-for="Cliente.CalleFiscalFld" class="form-control" />
                                            <span asp-validation-for="Cliente.CalleFiscalFld"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="Cliente.NumeroExteriorFiscalFld" class="form-label"></label>
                                            <input asp-for="Cliente.NumeroExteriorFiscalFld" class="form-control" />
                                            <span asp-validation-for="Cliente.NumeroExteriorFiscalFld"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="Cliente.NumeroInteriorFiscalFld" class="form-label"></label>
                                            <input asp-for="Cliente.NumeroInteriorFiscalFld" class="form-control" />
                                            <span asp-validation-for="Cliente.NumeroInteriorFiscalFld"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="Cliente.CodigoPostalFiscalFld" class="form-label"></label>
                                            <input asp-for="Cliente.CodigoPostalFiscalFld" class="form-control" />
                                            <span asp-validation-for="Cliente.CodigoPostalFiscalFld"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="Cliente.ColoniaFiscalFld" class="form-label"></label>
                                            <input asp-for="Cliente.ColoniaFiscalFld" class="form-control" />
                                            <span asp-validation-for="Cliente.ColoniaFiscalFld"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="Cliente.LocalidadFiscalFld" class="form-label"></label>
                                            <input asp-for="Cliente.LocalidadFiscalFld" class="form-control" />
                                            <span asp-validation-for="Cliente.LocalidadFiscalFld"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="Cliente.MunicipioFiscalFld" class="form-label"></label>
                                            <input asp-for="Cliente.MunicipioFiscalFld" class="form-control" />
                                            <span asp-validation-for="Cliente.MunicipioFiscalFld"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="Cliente.EntidadFiscalFld" class="form-label"></label>
                                            <input asp-for="Cliente.EntidadFiscalFld" class="form-control" />
                                            <span asp-validation-for="Cliente.EntidadFiscalFld"></span>
                                        </div>

                                    </div>
                                </div>
                                
                            </div>
                        </div>


                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" id="btnAnterior" class="btn mv-btn-secondary">
                        <i class="mdi mdi-arrow-left me-2"></i>Anterior
                    </button>
                    <button type="button" id="btnSiguiente" class="btn mv-btn-secondary">
                        <i class="mdi mdi-arrow-right me-2"></i>Siguiente
                    </button>
                    <button type="button" id="btnGuardar" class="btn mv-btn-primary">
                        <i class="mdi mdi-content-save me-2"></i>Guardar
                    </button>
                </div>

            </div>
        </div>
    </div>

</form>
@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}

<script>

    window.clienteEditConfig = {
    idModal: '@idModal',
    idForm: '@idForm',
    title: '@Html.Raw(title)'
    };

</script>

<script src="~/js/matvi.stepper.js"></script>
<script src="~/js/modules/Ventas/Cliente/Edit.js"></script>
