@page
@model Matvi.Front.UI.Areas.Finanzas.Pages.MovimientoBancario.IndexModel

@{
    ViewData["Title"] = "Movimientos Bancarios";
    ViewData["Modulo"] = "Finanzas";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_DataTablesStylesPartial")

<table id="movimiento-bancario-datatable"
       class="table table-sm table-hover activate-select dt-responsive nowrap w-100">
    <thead>
        <tr>
            <th class="text-start">Fecha</th>
            <th class="text-start">Banco / Cuenta</th>
            <th class="text-start">Tipo</th>
            <th class="text-start">Origen</th>
            <th class="text-start">Concepto / Tercero</th>
            <th class="text-start">Referencia</th>
            <th class="text-end">Monto</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<div id="ContainerModal"></div>

@section Scripts {
    @await Html.PartialAsync("_DataTablesScriptsPartial")
    <script src="~/js/modules/Finanzas/MovimientoBancario/Index.js" asp-append-version="true"></script>
}
