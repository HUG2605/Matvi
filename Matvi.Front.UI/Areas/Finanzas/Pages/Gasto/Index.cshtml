@page
@model Matvi.Front.UI.Areas.Finanzas.Pages.Gasto.IndexModel
@{
    ViewData["Title"] = "Gastos";
    ViewData["Modulo"] = "Finanzas";
    ViewData["RequiereSucursal"] = true;
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_DataTablesStylesPartial")

<table id="gasto-datatable"
       class="table table-sm table-hover activate-select dt-responsive nowrap w-100">
    <thead>
        <tr>
            <th class="text-center">Folio</th>
            <th class="text-center">Fecha</th>
            <th class="text-start">Tipo de gasto</th>
            <th>Proveedor</th>
            <th class="text-start">Medio de pago</th>
            <th class="text-end">Importe</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<div id="ContainerModal"></div>

@section Scripts {
    @await Html.PartialAsync("_DataTablesScriptsPartial")
    <script src="~/js/modules/Finanzas/Gasto/Index.js" asp-append-version="true"></script>
}