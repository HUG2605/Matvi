@page
@model Matvi.Front.UI.Areas.Finanzas.Pages.CorteCaja.AbrirModel
@{
    Layout = null;
    var title = "Abrir caja del día";
    var idModal = "mdlAbrirCaja";
    var idForm = "frmAbrirCaja";
}

<link href="~/css/matvi.stepper.css" rel="stylesheet" />

<form id="@idForm"
      class="needs-validation"
      method="post"
      asp-page-handler="Abrir"
      data-ajax="true"
      autocomplete="off"
      data-ajax-success="Success_Abrir">

    @Html.AntiForgeryToken()

    <div class="modal fade" id="@idModal" data-bs-backdrop="true" data-bs-keyboard="false"
         data-bs-focus="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h4 class="modal-title"><i class="mdi mdi-cash-register me-2 text-warning"></i>@title</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="mv-steps-vertical">

                        @* ====================== PASO 1: Guía de apertura ====================== *@
                        <div class="mv-step-vertical active">
                            <div class="mv-step-vertical-icon">1</div>
                            <div class="mv-step-vertical-content">
                                <div class="mv-step-vertical-title">Información y Guía</div>
                                <div id="collapseAbrirPaso1" class="mv-step-vertical-body collapse show">
                                    <div class="mv-empty-caja text-center py-3 my-2">
                                        <div class="mv-empty-caja-icono" style="width: 80px; height: 80px;">
                                            <i class="mdi mdi-cash-register" style="font-size: 2.5rem;"></i>
                                        </div>

                                        <h5 class="mt-3 mb-2 fw-semibold">Guía de Apertura de Caja</h5>
                                        <p class="text-muted mb-3 mv-empty-caja-texto small">
                                            Para comenzar a registrar cobros, gastos y ventas necesitas abrir la caja de la jornada.
                                            El sistema ligará automáticamente cada movimiento para que al cerrar puedas cuadrar tu fondo sin contratiempos.
                                        </p>

                                        <div class="mv-empty-pasos">
                                            <div class="mv-paso">
                                                <span class="mv-paso-numero">1</span>
                                                <h6 class="mb-0 small fw-bold">Abre la caja</h6>
                                                <small class="text-muted d-block" style="font-size: 0.75rem;">Captura tu fondo inicial y comienza la jornada.</small>
                                            </div>
                                            <div class="mv-paso">
                                                <span class="mv-paso-numero">2</span>
                                                <h6 class="mb-0 small fw-bold">Registra movimientos</h6>
                                                <small class="text-muted d-block" style="font-size: 0.75rem;">Cobros, gastos y pagos quedan ligados a esta caja.</small>
                                            </div>
                                            <div class="mv-paso">
                                                <span class="mv-paso-numero">3</span>
                                                <h6 class="mb-0 small fw-bold">Ciérrala</h6>
                                                <small class="text-muted d-block" style="font-size: 0.75rem;">Cuadra el fondo contado contra los totales.</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* ====================== PASO 2: Fondo inicial y datos ====================== *@
                        <div class="mv-step-vertical">
                            <div class="mv-step-vertical-icon">2</div>
                            <div class="mv-step-vertical-content">
                                <div class="mv-step-vertical-title">Fondo inicial y Datos de Apertura</div>
                                <div id="collapseAbrirPaso2" class="mv-step-vertical-body collapse">
                                    <div class="row g-3 py-2">

                                        <div class="col-md-6">
                                            <label class="form-label">Sucursal</label>
                                            <output class="form-control mv-output-control fw-bold">@Model.NombreSucursal</output>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">Usuario operador</label>
                                            <output class="form-control mv-output-control fw-bold">@Model.NombreUsuario</output>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <label asp-for="Corte.FondoInicial" class="form-label mv-form-label-required">Fondo inicial ($)</label>
                                            <div class="input-group">
                                                <span class="input-group-text p-0 ps-2 pe-2"><i class="mdi mdi-currency-usd"></i></span>
                                                <input asp-for="Corte.FondoInicial"
                                                       class="form-control fw-bold text-success"
                                                       type="number"
                                                       step="0.01"
                                                       min="0"
                                                       placeholder="0.00" />
                                            </div>
                                            <span asp-validation-for="Corte.FondoInicial" class="text-danger small"></span>
                                            <small class="text-muted d-block mt-1">Efectivo inicial asignado a la caja para cambio/morralla.</small>
                                        </div>

                                        <div class="col-12">
                                            <label asp-for="Corte.Notas" class="form-label">Notas / Observaciones</label>
                                            <div class="input-group">
                                                <span class="input-group-text p-0 ps-2 pe-2">
                                                    <i class="mdi mdi-note-text-outline"></i>
                                                </span>
                                                <textarea asp-for="Corte.Notas"
                                                          class="form-control"
                                                          rows="2"
                                                          placeholder="Opcional: anotaciones sobre el estado del turno o fondo inicial..."></textarea>
                                            </div>
                                            <span asp-validation-for="Corte.Notas" class="text-danger small"></span>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" id="btnAnterior" class="btn mv-btn-secondary">
                        <i class="mdi mdi-arrow-left me-2"></i>Anterior
                    </button>
                    <button type="button" id="btnSiguiente" class="btn mv-btn-secondary">
                        <i class="mdi mdi-arrow-right me-2"></i>Siguiente
                    </button>
                    <button type="button" id="btnGuardar" class="btn mv-btn-primary d-none">
                        <i class="mdi mdi-cash-plus me-2"></i>Abrir caja
                    </button>
                </div>

            </div>
        </div>
    </div>
</form>

@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
<script>
    window.cajaAbrirConfig = {
        idModal: '@idModal',
        idForm: '@idForm',
        title: '@Html.Raw(title)'
    };
</script>
<script src="~/js/matvi.stepper.js"></script>
<script src="~/js/modules/Finanzas/CorteCaja/Abrir.js"></script>