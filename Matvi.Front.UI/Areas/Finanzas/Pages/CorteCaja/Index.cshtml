@page
@model Matvi.Front.UI.Areas.Finanzas.Pages.CorteCaja.IndexModel
@using Matvi.Front.UI.Security.Permission
@using Matvi.Front.UI.Security.Services
@inject IUsuarioActualService UsuarioActualService
@{
    ViewData["Title"] = "Cortes de caja";
    ViewData["Modulo"] = "Finanzas";
    ViewData["RequiereSucursal"] = true;
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_DataTablesStylesPartial")

@if (Model.TieneSucursal)
{
    <div id="contenedorBotonNuevo" style="display:none;">
        @if (Model.Caja == null)
        {
            @if (UsuarioActualService.TienePermiso(Funcion.Finanzas_Cortes_de_caja, Accion.Crear))
            {
                <a id="btnNuevo" class="btn mv-btn-primary me-2 mb-1"
                   asp-page="/CorteCaja/Abrir"
                   data-ajax="true"
                   data-ajax-update="#ContainerModal"
                   data-ajax-method="GET"
                   data-ajax-mode="replace"
                   title="Abrir caja" aria-label="Abrir caja">
                    <i class="mdi mdi-cash-plus me-1"></i> Abrir caja
                </a>
            }
        }
        else
        {
            @if (UsuarioActualService.TienePermiso(Funcion.Finanzas_Cortes_de_caja, Accion.Crear))
            {
                <a id="btnCerrarTop" class="btn mv-btn-secondary me-2 mb-1"
                   asp-page="/CorteCaja/Cerrar"
                   data-ajax="true"
                   data-ajax-update="#ContainerModal"
                   data-ajax-method="GET"
                   data-ajax-mode="replace"
                   title="Cerrar caja">
                    <i class="mdi mdi-cash-lock me-1"></i> Cerrar caja
                </a>
            }

            <div class="btn-group me-2 mb-1">
                <button type="button" class="btn mv-btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="mdi mdi-plus-circle-outline me-1"></i> Nuevo
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    @if (UsuarioActualService.TienePermiso(Funcion.Finanzas_Cobros, Accion.Crear))
                    {
                        <li>
                            <a class="dropdown-item" asp-page="/CorteCaja/CrearCobro"
                               data-ajax="true"
                               data-ajax-update="#ContainerModal"
                               data-ajax-method="GET"
                               data-ajax-mode="replace">
                                <i class="mdi mdi-hand-coin-outline me-2"></i>Cobro
                            </a>
                        </li>
                    }
                    @if (UsuarioActualService.TienePermiso(Funcion.Finanzas_Gastos, Accion.Crear))
                    {
                        <li>
                            <a class="dropdown-item" asp-page="/CorteCaja/CrearGasto"
                               data-ajax="true"
                               data-ajax-update="#ContainerModal"
                               data-ajax-method="GET"
                               data-ajax-mode="replace">
                                <i class="mdi mdi-cash-minus-outline me-2"></i>Gasto
                            </a>
                        </li>
                    }
                    @if (UsuarioActualService.TienePermiso(Funcion.Finanzas_Pagos, Accion.Crear))
                    {
                        <li>
                            <a class="dropdown-item" asp-page="/CorteCaja/CrearPago"
                               data-ajax="true"
                               data-ajax-update="#ContainerModal"
                               data-ajax-method="GET"
                               data-ajax-mode="replace">
                                <i class="mdi mdi-cash-outline me-2"></i>Pago
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    @if (Model.Caja != null)
    {
        <div class="card card-body mb-3 shadow-sm border-start border-4 border-success">
            <div class="d-flex flex-wrap align-items-center gap-4">
                <span class="badge bg-success px-2 py-1">
                    <i class="mdi mdi-lock-open-variant me-1"></i>CAJA ABIERTA
                </span>
                <span class="small">
                    Folio: <strong>@Model.Caja.Folio</strong>
                </span>
                <span class="small">
                    Apertura: <strong>@Model.Caja.FechaApertura.ToString("dd/MM/yyyy HH:mm:ss")</strong>
                </span>
                <span class="small">
                    Fondo inicial: <strong>@Model.Caja.FondoInicial.ToTruncateMoney()</strong>
                </span>
            </div>
        </div>
    }
    else
    {
        <div class="card border border-warning bg-body-tertiary mb-3 shadow-sm">
            <div class="card-body p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar-md flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle bg-warning-subtle text-warning" style="width: 52px; height: 52px;">
                        <i class="mdi mdi-cash-register fs-2"></i>
                    </div>
                    <div>
                        <h5 class="mb-1 font-weight-bold">No hay una caja abierta actualmente</h5>
                        <p class="text-muted mb-0 small">
                            Para comenzar a registrar cobros, gastos y ventas necesitas abrir la caja de la jornada.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }

    <div id="corte-historial" class="d-flex align-items-center gap-2 mb-2">
        <i class="mdi mdi-file-table-outline mv-text-enf4"></i>
        <h5 class="mb-0">Historial de cortes</h5>
    </div>

    <table id="corte-datatable"
           class="table table-sm table-hover activate-select dt-responsive nowrap w-100">
        <thead>
            <tr>
                <th class="text-start">Folio</th>
                <th class="text-start">Fecha apertura</th>
                <th class="text-start">Fecha cierre</th>
                <th class="text-start">Usuario</th>
                <th class="text-end">Fondo inicial</th>
                <th class="text-end">Diferencia</th>
                <th class="text-center">Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>

    <div id="ContainerModal"></div>
}

@section Scripts {
    @await Html.PartialAsync("_DataTablesScriptsPartial")
    <script src="~/js/modules/Finanzas/CorteCaja/Index.js" asp-append-version="true"></script>
}