@page
@using Matvi.Front.UI.Security.Permission
@using Matvi.Front.UI.Security.Services
@inject IUsuarioActualService UsuarioActualService
@model Matvi.Front.UI.Areas.Seguridad.Pages.Usuario.IndexModel
@{
    ViewData["Title"] = "Usuarios";
    ViewData["Modulo"] = "Seguridad";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_DataTablesStylesPartial")

<div id="contenedorBotonNuevo" style="display:none;">
    @if (UsuarioActualService.TienePermiso(Funcion.Seguridad_Usuarios, Accion.Crear))
    {
        <a id="btnNuevo" class="btn mv-btn-primary me-2 mb-1"
           asp-page="/Usuario/Create"
           data-ajax="true"
           data-ajax-update="#ContainerModal"
           data-ajax-method="GET"
           data-ajax-mode="replace"
           title="Crear" aria-label="Crear">
            <i class="mdi mdi-plus-circle-outline"></i> Nuevo
        </a>
    }
</div>

<table id="usuario-datatable" class="table table-sm table-hover activate-select dt-responsive nowrap w-100">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Teléfono</th>
            <th>Rol</th>
            <th>Usuario</th>
            <th>Activo</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<div id="ContainerModal">
</div>

@section Scripts {
    @await Html.PartialAsync("_DataTablesScriptsPartial")
    <script src="~/js/modules/Seguridad/Usuario/Index.js" asp-append-version="true"></script>
}