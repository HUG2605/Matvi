@page
@using Matvi.Back.Application.Modules.Compras.Compra.Dtos
@model Matvi.Front.UI.Areas.Compras.Pages.Compra.CreateModel
@{
    Layout = null;
    var title = "Datos de la compra";
    var idModal = "mdlCreateCompra";
    var idForm = "frmCreateCompra";
}
<link href="~/css/matvi.stepper.css" rel="stylesheet" />
<form id="@idForm"
      class="needs-validation"
      method="post"
      asp-page-handler="Create"
      data-ajax="true"
      autocomplete="off"
      data-ajax-success="Success_Create">

    @Html.AntiForgeryToken()

    <div class="modal fade" id="@idModal" data-bs-backdrop="true" data-bs-keyboard="false"
         data-bs-focus="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
            <div class="modal-content">

                <div class="modal-header">
                    <h4 class="modal-title">@title</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="row">
                        <div class="col text-start">
                            <h5 class="mv-text-enf3">
                                <i class="mdi mdi-plus-circle-outline me-2"></i> Nuevo
                            </h5>
                        </div>
                        <div class="col text-end">
                            <label class="form-label text-danger">&#9679; Valores requeridos</label>
                        </div>
                    </div>

                    <div class="mv-steps-vertical">

                        @* PASO 1: GENERALES *@
                        <div class="mv-step-vertical active">
                            <div class="mv-step-vertical-icon">1</div>
                            <div class="mv-step-vertical-content">
                                <div class="mv-step-vertical-title">Generales</div>
                                <div id="collapseGenerales" class="mv-step-vertical-body collapse show">
                                    <div class="row g-3">

                                        <div class="col-12">
                                            <label asp-for="Compra.CtProv_IdFld" class="form-label mv-form-label-required"></label>
                                            <select asp-for="Compra.CtProv_IdFld" class="form-select w-100"></select>
                                            <span asp-validation-for="Compra.CtProv_IdFld"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* PASO 2: PRODUCTOS *@
                        <div class="mv-step-vertical">
                            <div class="mv-step-vertical-icon">2</div>
                            <div class="mv-step-vertical-content">
                                <div class="mv-step-vertical-title">Productos</div>
                                <div id="collapseProductos" class="mv-step-vertical-body collapse">

                                    <div id="alertSinProveedor" class="alert alert-warning d-flex align-items-center mb-3 d-none">
                                        <i class="mdi mdi-alert-outline me-2 fs-5"></i>
                                        <span>Debe seleccionar un <strong>proveedor</strong> en el paso anterior antes de agregar productos.</span>
                                    </div>

                                    <div id="frmAgregarProducto">
                                        <div class="row g-3">

                                            <div class="col-12">
                                                <label class="form-label">Producto</label>
                                                <select id="slcProducto" class="form-select" disabled></select>
                                                <small id="txtHintProducto" class="text-muted d-none">
                                                    <i class="mdi mdi-information-outline me-1"></i>
                                                    Solo se muestran productos del proveedor seleccionado.
                                                </small>
                                            </div>

                                            <div class="col-12 col-md-6 col-lg-5 col-xl-6">
                                                <label class="form-label mv-form-label-required">Presentación</label>
                                                <select id="slcPresentacionProducto"
                                                        name="idPresentacionProducto"
                                                        class="form-select"
                                                        aria-describedby="idPresentacionProducto-error"
                                                        disabled>
                                                </select>
                                                <span class="field-validation-valid"
                                                      data-valmsg-for="idPresentacionProducto"
                                                      data-valmsg-replace="true">
                                                    <span id="idPresentacionProducto-error"></span>
                                                </span>
                                            </div>

                                            <div class="col-6 col-md-3 col-lg-2 col-xl-2">
                                                <label class="form-label mv-form-label-required">Cantidad</label>
                                                <input id="txtCantidad"
                                                       name="cantidad"
                                                       class="form-control"
                                                       type="number"
                                                       min="1"
                                                       step="1"
                                                       aria-describedby="cantidad-error"
                                                       disabled />
                                                <span class="field-validation-valid"
                                                      data-valmsg-for="cantidad"
                                                      data-valmsg-replace="true">
                                                    <span id="cantidad-error"></span>
                                                </span>
                                            </div>

                                            <div class="col-6 col-md-3 col-lg-2 col-xl-2">
                                                <label class="form-label mv-form-label-required">Costo</label>
                                                <div class="input-group flex-nowrap">
                                                    <span class="input-group-text p-0 ps-2 pe-2"><i class="mdi mdi-currency-usd"></i></span>
                                                    <input id="txtCosto"
                                                           name="costo"
                                                           class="form-control"
                                                           type="number"
                                                           min="0"
                                                           step="0.01"
                                                           style="min-width: 0; width: 1%;"
                                                           aria-describedby="costo-error"
                                                           disabled />
                                                </div>
                                                <span class="field-validation-valid"
                                                      data-valmsg-for="costo"
                                                      data-valmsg-replace="true">
                                                    <span id="costo-error"></span>
                                                </span>
                                            </div>

                                            <div class="col-12 col-lg-3 col-xl-2">
                                                <label class="form-label d-none d-md-block">&nbsp;</label>
                                                <button type="button" id="btnAgregar"
                                                        class="btn mv-btn-primary w-100"
                                                        disabled>
                                                    <i class="mdi mdi-plus-thick me-1"></i>Agregar
                                                </button>
                                            </div>

                                        </div>
                                    </div>

                                    <div id="ContainerProductos">
                                        @await Html.PartialAsync("_ListAgregarProductoCompra", new List<AgregarProductoCompraDto>())
                                    </div>

                                </div>
                            </div>
                        </div>

                        @* PASO 3: PAGO *@
                        <div class="mv-step-vertical">
                            <div class="mv-step-vertical-icon">3</div>
                            <div class="mv-step-vertical-content">
                                <div class="mv-step-vertical-title">Pago</div>
                                <div id="collapsePago" class="mv-step-vertical-body collapse">
                                    <div class="row g-3">

                                        <div class="col-6 col-md-4">
                                            <label class="form-label">Saldo vencido</label>
                                            <div class="input-group">
                                                <span class="input-group-text p-0 ps-2 pe-2"><i class="mdi mdi-currency-usd"></i></span>
                                                <input id="txtSaldoVencido" type="text" class="form-control" disabled readonly />
                                            </div>
                                        </div>

                                        <div class="col-6 col-md-4">
                                            <label class="form-label">Total pedido</label>
                                            <div class="input-group">
                                                <span class="input-group-text p-0 ps-2 pe-2"><i class="mdi mdi-currency-usd"></i></span>
                                                <input id="txtTotalPedido" type="text" class="form-control" disabled readonly />
                                            </div>
                                        </div>

                                        <div class="col-6 col-md-4">
                                            <label class="form-label">Total</label>
                                            <div class="input-group">
                                                <span class="input-group-text p-0 ps-2 pe-2"><i class="mdi mdi-currency-usd"></i></span>
                                                <input id="txtTotal" type="text" class="form-control" disabled readonly />
                                            </div>
                                        </div>

                                        <div class="col-12"></div>

                                        <div class="col-6 col-md-4">
                                            <label asp-for="Compra.CtMediPago_IdFld" class="form-label mv-form-label-required"></label>
                                            <select asp-for="Compra.CtMediPago_IdFld"
                                                    class="form-select"
                                                    asp-items="Model.MedioPagoSelectList">
                                                <option value="value">SELECCIONAR</option>
                                            </select>
                                            <span asp-validation-for="Compra.CtMediPago_IdFld"></span>
                                        </div>

                                        <div class="col-6 col-md-4">
                                            <label asp-for="Compra.PagoFld" class="form-label mv-form-label-required"></label>
                                            <div class="input-group">
                                                <span class="input-group-text p-0 ps-2 pe-2"><i class="mdi mdi-currency-usd"></i></span>
                                                <input asp-for="Compra.PagoFld"
                                                       class="form-control"
                                                       type="number"
                                                       step="0.01" />
                                            </div>
                                            <span asp-validation-for="Compra.PagoFld"></span>
                                        </div>

                                        <div class="col-6 col-md-4">
                                            <label class="form-label">Saldo pendiente</label>
                                            <div class="input-group">
                                                <span class="input-group-text p-0 ps-2 pe-2"><i class="mdi mdi-currency-usd"></i></span>
                                                <input id="txtSaldoPendiente" type="text" class="form-control" disabled readonly value="0.00" />
                                            </div>
                                        </div>

                                        <div class="col-md-12">
                                            <label asp-for="Compra.NotasPagoFld" class="form-label"></label>
                                            <div class="input-group">
                                                <span class="input-group-text p-0 ps-2 pe-2">
                                                    <i class="mdi mdi-note"></i>
                                                </span>
                                                <textarea asp-for="Compra.NotasPagoFld"
                                                          class="form-control"
                                                          rows="2"></textarea>
                                            </div>
                                            <span asp-validation-for="Compra.NotasPagoFld"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" id="btnAnterior" class="btn mv-btn-secondary">
                        <i class="mdi mdi-arrow-left me-2"></i>Anterior
                    </button>
                    <button type="button" id="btnSiguiente" class="btn mv-btn-secondary">
                        <i class="mdi mdi-arrow-right me-2"></i>Siguiente
                    </button>
                    <button type="button" id="btnGuardar" class="btn mv-btn-primary d-none">
                        <i class="mdi mdi-content-save me-2"></i>Guardar
                    </button>
                </div>

            </div>
        </div>
    </div>

</form>

@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
    await Html.RenderPartialAsync("_Select2ScriptsPartial");
}
<script>
    window.compraCreateConfig = {
        idModal: '@idModal',
        idForm: '@idForm',
        title: '@Html.Raw(title)'
    };
</script>
<script src="~/js/matvi.stepper.js"></script>
<script src="~/js/modules/Compras/Compra/Create.js"></script>