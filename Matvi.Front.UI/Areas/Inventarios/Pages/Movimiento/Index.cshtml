@page
@using Matvi.Front.UI.Security.Permission
@using Matvi.Front.UI.Security.Services
@inject IUsuarioActualService UsuarioActualService
@model Matvi.Front.UI.Areas.Inventarios.Pages.Movimiento.IndexModel
@{
    ViewData["Title"] = "Movimientos";
    ViewData["Modulo"] = "Inventarios";
    ViewData["RequiereSucursal"] = true;
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("_DataTablesStylesPartial")

<div id="contenedorBotonNuevo" style="display:none;">
    @if (UsuarioActualService.TienePermiso(Funcion.Inventarios_Movimientos, Accion.Crear))
    {
        <a id="btnNuevo" class="btn mv-btn-primary me-2 mb-1"
           asp-page="/Movimiento/Create"
           data-ajax="true"
           data-ajax-update="#ContainerModal"
           data-ajax-method="GET"
           data-ajax-mode="replace"
           title="Crear" aria-label="Crear">
            <i class="mdi mdi-plus-circle-outline"></i> Nuevo
        </a>
    }
</div>

@* nowrap *@
<table id="movimiento-datatable" class="table table-sm table-hover activate-select dt-responsive w-100">
    <thead>
        <tr>
            <th class="text-start text-nowrap">Folio</th>
            <th class="text-start text-nowrap">Fecha</th>
            <th class="text-start text-nowrap">Tipo Movimiento</th>
            <th class="text-start">Producto</th>
            <th class="text-start text-nowrap">Presentación</th>
            <th class="text-end text-nowrap">Cantidad</th>
            <th class="text-center text-nowrap">Acciones</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<div id="ContainerModal"></div>

@section Scripts {
    @await Html.PartialAsync("_DataTablesScriptsPartial")
    <script src="~/js/modules/Inventarios/Movimiento/Index.js" asp-append-version="true"></script>
}