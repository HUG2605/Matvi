@page
@using Matvi.Front.UI.Extensions
@using Matvi.Front.UI.Security.Permission
@using Matvi.Front.UI.Security.Services
@inject IUsuarioActualService UsuarioActualService
@model Matvi.Front.UI.Areas.Inventarios.Pages.Lote.DetailsModel
@{
    ViewData["Title"] = "Lotes";
    ViewData["Modulo"] = "Inventarios";
    ViewData["UrlAnterior"] = Url.Page("Index");
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="row align-items-start gy-2">
    <div class="col-auto">
        <div class="align-items-center justify-content-center mv-perfil-circle">
            @Model.GetProfileLetters(Model.Lote!.CtProd_NombreCompleto!)
        </div>
    </div>

    <!-- Nombre y subtítulo -->
    <div class="col">
        <h4 class="mb-0">@Model.Lote.CtProd_NombreCompleto</h4>
        <span class="text-muted">@Model.Lote.CtTipoLote_Nombre</span>

        <!-- Botones visibles en pantallas pequeñas -->
        <div class="d-block d-md-none mt-2">
            @await Html.PartialAsync("_DetailsActions", Model.Lote)
        </div>
    </div>

    <!-- Botones alineados a la derecha en pantallas grandes -->
    <div class="col-auto d-none d-md-flex justify-content-end align-items-center">
        @await Html.PartialAsync("_DetailsActions", Model.Lote)
    </div>
</div>

<div>
    <ul class="nav nav-tabs nav-bordered">
        <li class="nav-item">
            <a href="#home-b1" data-bs-toggle="tab" aria-expanded="false" class="nav-link active">
                <span class="d-inline-block d-sm-none"><i class="mdi mdi-home-variant"></i></span>
                <span class="d-none d-sm-inline-block">General</span>
            </a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane show active" id="home-b1">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombre de la Sucursal</label>
                    <output class="form-control mv-output-control">
                        @Model.Lote.CtSucu_Nombre
                    </output>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Tipo de Lote</label>
                    <output class="form-control mv-output-control">
                        @Model.Lote.CtTipoLote_Nombre
                    </output>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Producto</label>
                    <output class="form-control mv-output-control">
                        @Model.Lote.CtProd_NombreCompleto
                    </output>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Presentación</label>
                    <output class="form-control mv-output-control">
                        @Model.Lote.CtPresProd_Nombre
                    </output>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Factor UBI</label>
                    <div class="input-group">
                        <output class="form-control mv-output-control">
                            @Model.Lote.CtPresProd_FactorUBI
                        </output>
                        <span class="input-group-text p-0 ps-2 pe-2">
                            @Model.Lote.CtUnidBaseInve_Abreviatura
                        </span>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Cantidad Inicial</label>
                    <div class="input-group">
                        <output class="form-control mv-output-control">
                            @Model.Lote.CantidadInicialUBI
                        </output>
                        <span class="input-group-text p-0 ps-2 pe-2">
                            @Model.Lote.CtUnidBaseInve_Abreviatura
                        </span>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Cantidad Disponible</label>
                    <div class="input-group">
                        <output class="form-control mv-output-control">
                            @Model.Lote.CantidadDisponibleUBI
                        </output>
                        <span class="input-group-text p-0 ps-2 pe-2">
                            @Model.Lote.CtUnidBaseInve_Abreviatura
                        </span>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Costo Unitario</label>
                    <div class="input-group">
                        <span class="input-group-text p-0 ps-2 pe-2">
                            <i class="mdi mdi-currency-usd"></i>
                        </span>
                        <output class="form-control mv-output-control">
                            @Model.Lote.CostoUnitario
                        </output>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Costo Unitario Base</label>
                    <div class="input-group">
                        <span class="input-group-text p-0 ps-2 pe-2">
                            <i class="mdi mdi-currency-usd"></i>
                        </span>
                        <output class="form-control mv-output-control">
                            @Model.Lote.CostoUnitarioBase
                        </output>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Fecha</label>
                    <div class="input-group">
                        <span class="input-group-text p-0 ps-2 pe-2">
                            <i class="mdi mdi-calendar"></i>
                        </span>
                        <output class="form-control mv-output-control">
                            @Model.Lote.Fecha
                        </output>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="ContainerModal">
</div>

