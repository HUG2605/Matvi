@page
@using Matvi.Front.UI.Security.Permission
@using Matvi.Front.UI.Security.Services
@inject IUsuarioActualService UsuarioActualService
@model Matvi.Front.UI.Areas.Inventarios.Pages.Lotes.IndexModel
@{
    ViewData["Title"] = "Lotes";
    ViewData["Modulo"] = "Inventarios";
    ViewData["RequiereSucursal"] = true;
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("_DataTablesStylesPartial")

@* nowrap *@
<table id="lote-datatable" class="table table-sm table-hover activate-select dt-responsive w-100">
    <thead>
        <tr>
            <th class="text-start text-nowrap">Folio</th>
            <th class="text-start text-nowrap">Tipo Lote</th>
            <th class="text-start">Producto</th>
            <th class="text-start text-nowrap">Presentación</th>
            <th class="text-end text-nowrap">Factor UBI</th>
            <th class="text-end text-nowrap">Cantidad Inicial</th>
            <th class="text-end text-nowrap">Cantidad Disponible</th>
            <th class="text-center text-nowrap">Acciones</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<div id="ContainerModal"></div>

@section Scripts {
    @await Html.PartialAsync("_DataTablesScriptsPartial")
    <script src="~/js/modules/Inventarios/Lote/Index.js" asp-append-version="true"></script>
}