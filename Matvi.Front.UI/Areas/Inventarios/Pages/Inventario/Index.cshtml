@page
@model Matvi.Front.UI.Areas.Inventarios.Pages.Inventario.IndexModel
@{
    ViewData["Title"] = "Inventario";
    ViewData["Modulo"] = "Inventarios";
    ViewData["RequiereSucursal"] = true;
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("_DataTablesStylesPartial")

@* nowrap *@
<table id="inventario-datatable" class="table table-sm table-hover activate-select dt-responsive w-100">
    <thead>
        <tr>
            <th>Producto</th>
            <th class="text-center text-nowrap">Stock mínimo UBI</th>
            <th class="text-center text-nowrap">Existencias UBI</th>
            <th class="text-center text-nowrap">Stock máximo UBI</th>
            <th class="text-center text-nowrap">Regularizado</th>
            <th class="text-center text-nowrap">Acciones</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<div id="ContainerModal"></div>

@section Scripts {
    @await Html.PartialAsync("_DataTablesScriptsPartial")
    <script src="~/js/modules/Inventarios/Inventario/Index.js" asp-append-version="true"></script>
}