@page
@using Matvi.Front.UI.Extensions
@using Matvi.Front.UI.Security.Permission
@using Matvi.Front.UI.Security.Services
@inject IUsuarioActualService UsuarioActualService
@model Matvi.Front.UI.Areas.Configuracion.Pages.Sucursal.DetailsModel
@{
    ViewData["Title"] = "Sucursal";
    ViewData["Modulo"] = "Configuración";
    ViewData["UrlAnterior"] = Url.Page("Index");
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<div class="row align-items-start gy-2">
    <div class="col-auto">
        <div class="align-items-center justify-content-center mv-perfil-circle">
            @Model.GetProfileLetters(Model.Sucursal!.Nombre!)
        </div>
    </div>

    <div class="col">
        <h4 class="mb-0">@Model.Sucursal.Nombre</h4>
        <span class="text-muted">Tel: @Model.Sucursal.Telefono!.ToPhoneFormat()</span>

        <!-- Botones visibles en pantallas pequeñas -->
        <div class="d-block d-md-none mt-2">
            @await Html.PartialAsync("_DetailsActions", Model.Sucursal.SafeId)
        </div>
    </div>

    <!-- Botones alineados a la derecha en pantallas grandes -->
    <div class="col-auto d-none d-md-flex justify-content-end align-items-center">
        @await Html.PartialAsync("_DetailsActions", Model.Sucursal.SafeId)
    </div>
</div>

<div>
    <ul class="nav nav-tabs nav-bordered">
        <li class="nav-item">
            <a href="#home-b1" data-bs-toggle="tab" aria-expanded="false" class="nav-link active">
                <span class="d-inline-block d-sm-none"><i class="mdi mdi-home-variant"></i></span>
                <span class="d-none d-sm-inline-block">General</span>
            </a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane show active" id="home-b1">
            <div class="row g-3">
                <div class="col-md-9">
                    <label class="form-label">Nombre</label>
                    <output class="form-control mv-output-control">
                        @Model.Sucursal.Nombre
                    </output>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Clave</label>
                    <output class="form-control mv-output-control">
                        @Model.Sucursal.Clave
                    </output>
                </div>

                <div class="col-md-12">
                    <label class="form-label">Dirección</label>
                    <output class="form-control mv-output-control">
                        @Model.Sucursal.Dirección
                    </output>
                </div>
            
                <div class="col-md-3">
                    <label class="form-label">Teléfono</label>
                    <div class="input-group">
                        <span class="input-group-text p-0 ps-2 pe-2">
                            <i class="mdi mdi-phone"></i>
                        </span>
                        <output class="form-control mv-output-control">
                            @Model.Sucursal.Telefono!.ToPhoneFormat()
                        </output>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div id="ContainerModal">
</div>

@section Scripts {
    <script>
        window.sucursalDeleteConfig = {
            title: '@Html.Raw(ViewData["Title"])',
            safeId: '@Model.Sucursal.SafeId',
            urlAnterior: '@ViewData["UrlAnterior"]',
            urlBase: '/Configuracion/Sucursal'
        };
    </script>
    <script src="~/js/modules/configuracion/sucursal/delete.js"></script>
}