@page
@model Matvi.Front.UI.Areas.Configuracion.Pages.Empresa.IndexModel
@{
    ViewData["Title"] = "Empresa";
    ViewData["Modulo"] = "Configuración";
    // ViewData["RequiereSucursal"] = true;
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("_DataTablesStylesPartial")

<table id="empresa-datatable" class="table table-sm table-hover activate-select dt-responsive nowrap w-100">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Teléfono</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts {
    @await Html.PartialAsync("_DataTablesScriptsPartial")
    <script src="~/js/modules/Configuracion/Empresa/Index.js" asp-append-version="true"></script>
}